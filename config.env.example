# Sentinel Guard — example config (copy ke /etc/sentinel-guard/config.env)
# Ganti semua nilai di bawah dengan milikmu. JANGAN commit config asli!

# Telegram alert (wajib — sentinel kirim alert ke sini)
TELEGRAM_BOT_TOKEN=[REDACTED]
TELEGRAM_CHAT_ID=[REDACTED]
BOT_TOKEN_FALLBACK_FILE=""

# Unit yang di-watch (systemd units — otomatis skip kalau systemctl tidak ada)
WATCH_UNITS=""
# JSON state files yang divalidasi (harus valid JSON)
STATE_FILES="/path/to/state.json"
CRASH_THRESHOLD=3
CRASH_WINDOW_SEC=600
CASCADE_THRESHOLD=3

# --- Modul keamanan v2.0 ---
# [MODE WAJIB PILIH] SENTINEL_MODE = "alert" (default, aman) ATAU "auto".
#   alert = deteksi + alert TAPI tidak auto-eksekusi aksi destruktif.
#   auto  = auto-response: AUTO_* di bawah aktif (kill/ban/revert lockout risk).
# Pas first-run, wizard kirim notice 1x minta user set mode eksplisit + nyalakan
# AUTO_* yang diinginkan SATU PER SATU. Jangan semua auto sekali boot.
#SENTINEL_MODE=alert
# [FRESH-INSTALL DEFAULT — alert-only] SEMUA AUTO_* default OFF.
# Sentinel MENJALANKAN deteksi + ALERT, TAPI TIDAK auto-eksekusi aksi destruktif
# (auto-kill, auto-ban, auto-purge SSH key, auto-revert cron, auto-lockdown)
# sampai Bos menyalakan eksplisit per-trigger. Alasan: aksi auto ini bisa
# lockout/boomerang di mesin fresh yang belum di-konfigurasi benar (contoh:
# AUTO_PURGE_KEYS hapus SSH key = lockout kalau whitelist kosong; AUTO_REVERT_CRON
# revert crontab = bisa hapus cron legit lain). Aktifkan SATU PER SATU setelah
# paham perilakunya.
#   Contoh produksi-aman: AUTO_KILL_SUSPICIOUS=on (kill proses miner/reverse-shell)
#   Tapi jangan semua sekali jalan pas first boot.
PORT_WATCH=on
PORT_WHITELIST="22 80 443"
AUTO_BLOCK_PORTS=off
SSH_WATCH=on
AUTO_PURGE_KEYS=off
PROC_WATCH=on
AUTO_KILL_SUSPICIOUS=off
CRON_WATCH=on
AUTO_REVERT_CRON=off
FILE_WATCH=on
TRIPWIRE_FILES="/root/.bashrc /root/.profile /root/.ssh/authorized_keys"
AUTO_LOCKDOWN=off

# --- Modul v2.5 (Immutable + Auth + Secret) ---
IMMUTABLE_WATCH=on
IMMUTABLE_FILES=""
AUTH_WATCH=on
FAILED_THRESHOLD=10
AUTO_BAN_IP=off
SECRET_WATCH=on
ENFORCE_600=on

# --- Modul v2.6 (HTTP Service Watch — container-aware, no systemd) ---
# Format: "nama|url|expected_http_code" (space-separated)
HTTP_WATCH=off
HTTP_SERVICES=""
# Restart command per service (dipanggil kalau service down)
MYAPP_RESTART_CMD="cd /path/to/app && nohup python3 server.py > /var/log/myapp.log 2>&1 &"

# --- v3.0 PHOENIX ---
LIFE_LOOP=on
LIFE_LOOP_PARTNER=hermes-2
LIFE_LOOP_MAX_AGE=300
SENTINEL_IDENTITY=hermes-1

# --- Modul v3.4 (OSSEC/Fail2ban-style upgrades) ---
FIM_WATCH=on
FIM_FILES="/etc/passwd /etc/shadow /etc/group /etc/sudoers /etc/ssh/sshd_config /etc/crontab /etc/hosts"
FIM_UPDATE_BASELINE=off
AUTH_BAN_WATCH=on
BAN_MAXRETRY=5
BAN_FINDTIME=600
BAN_TIME=3600
ROOTCHECK_WATCH=on
ROOTCHECK_SETUID_WHITELIST=""

# --- Modul v3.5 (hardening) ---
# IP yang gak boleh di-ban oleh auth-ban (fail2ban ignoreip)
BAN_IP_WHITELIST=""
# FIM: restore otomatis dari backup kalau file kritis berubah (OSSEC-style)
FIM_AUTO_RESTORE=off
# Interface yang di-whitelist dari check promiscuous (docker bridge dll)
ROOTCHECK_PROMISC_WHITELIST=""

# --- PILAR S — GITHUB REPO MONITOR (anti-deface) ---
# Poll last commit per repo (Atom feed public / API private), alert kalau author != owner
GITHUB_WATCH=on
GITHUB_OWNER=<github-owner>
GITHUB_REPOS="<owner>/<repo>"
